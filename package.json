{
  "name": "gemini-whisper",
  "version": "2.1.0",
  "description": "Modern AI-powered voice transcription app with Gemini 3.5 model support",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "axios": "^1.6.7",
    "dotenv": "^16.4.5",
    "electron-store": "^8.1.0",
    "mic": "^2.1.1"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.geminiwhisper.app",
    "productName": "GeminiWhisper",
    "win": {
      "icon": "icon.ico",
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createStartMenuShortcut": true,
      "createDesktopShortcut": true
    },
    "files": [
      "**/*",
      "!node_modules/.cache",
      "!src/**/*"
    ],
    "extraResources": [
      {
        "from": "bin/sox/",
        "to": "bin/sox"
      }
    ],
    "directories": {
      "output": "release"
    }
  }
}
